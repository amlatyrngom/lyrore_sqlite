+  for(i = 0; i < 10; i += 2){
+    rc = lyroreUnregisterPattern(db, (LyrorePatternId)(LYRORE_PAT_COST_BASE + 60 + i));
+    TEST_ASSERT(rc == SQLITE_OK, "Pattern unregistered in loop");
